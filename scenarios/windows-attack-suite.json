{
  "scenario_id": "windows-phase1-attack-suite",
  "description": "Deterministic Windows-oriented policy cases for source access, secrets, traversal, protected workflow edits, destructive Git commands, and network policy.",
  "workspace_root": "/workspace",
  "steps": [
    {"action_id":"read-source","description":"Read source under staged workspace","category":"filesystem","operation":"read","target":"/workspace/src/main.py","expected_decision":"allow"},
    {"action_id":"read-dotenv","description":"Attempt to read root environment secrets","category":"filesystem","operation":"read","target":"/workspace/.env","expected_decision":"deny"},
    {"action_id":"read-nested-key","description":"Attempt to read nested private key","category":"filesystem","operation":"read","target":"/workspace/config/id_ed25519","expected_decision":"deny"},
    {"action_id":"traversal","description":"Attempt parent-directory traversal","category":"filesystem","operation":"read","target":"../../Users/Public/secrets.txt","expected_decision":"deny"},
    {"action_id":"edit-workflow","description":"Modify a CI workflow","category":"filesystem","operation":"write","target":"/workspace/.github/workflows/build.yml","expected_decision":"require_approval"},
    {"action_id":"force-push","description":"Attempt force push","category":"command","operation":"exec","target":"git.exe push --force origin main","expected_decision":"deny"},
    {"action_id":"hard-reset","description":"Attempt destructive Git reset","category":"command","operation":"exec","target":"git.exe reset --hard HEAD","expected_decision":"require_approval"},
    {"action_id":"unlisted-network","description":"Connect to an unlisted host","category":"network","operation":"connect","target":"evil.example.com:443","expected_decision":"deny"},
    {"action_id":"allowed-llm","description":"Connect to the configured Gemini inference API","category":"network","operation":"connect","target":"generativelanguage.googleapis.com:443","expected_decision":"allow"}
  ]
}
